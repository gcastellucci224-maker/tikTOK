# List of the settings to create in Vercel > Project > Settings > Environment Variables.
# Keep your GitHub repository PRIVATE when storing credentials in code or config.

# --- PayPal (REST API App from developer.paypal.com/dashboard/) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# PAYPAL_ENV=auto              # auto (detects sandbox/live automatically) | sandbox | production
# PAYPAL_WEBHOOK_ID=           # optional: webhook ID (starts with WH- or similar), shown by /api/setup-webhook

# --- GitHub (the database: one PRIVATE repository, separate from the website's one) ---
GITHUB_TOKEN=                # fine-grained token, "Contents: Read and write" on that repository only
GITHUB_REPO=                 # owner/repository, e.g. mario/reset72h-orders
# GITHUB_BRANCH=               # optional: leave empty to use the default branch

# --- Email (Resend) ---
RESEND_API_KEY=                # starts with re_
EMAIL_FROM=                    # e.g. 72H Reset Protocol <hello@yourdomain.com>  (domain verified in Resend)
# SUPPORT_EMAIL=               # optional: address customers can reply to

# --- Product files ---
PRODUCT_URL=                   # https link of the manual + workbook
BONUS_URL=                     # https link of the 5 audio tracks
# PRODUCT_URL_IT=              # optional: a different file for Italian buyers (same for BONUS_URL_IT)
DOWNLOAD_SECRET=               # a long random text (at least 24 characters): signs the download links

# --- Optional ---
# SITE_URL=                    # e.g. https://yourdomain.com (recommended once you have your own domain)
# SETUP_TOKEN=                 # a long random text, needed only while you run /api/setup-webhook
# PRICE_CENTS=1490             # change only together with PRICE in public/index.html
# BUMP_CENTS=490
